# LiveKit Voice Agent Integration - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# LiveKit Configuration
# ============================================
# Your LiveKit server URL (Cloud or self-hosted)
# Example: https://your-project.livekit.cloud
LIVEKIT_URL=

# LiveKit API credentials (generate from LiveKit Cloud Console)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ============================================
# Webhook Configuration
# ============================================
# URL where the collected data will be sent via HTTP POST
# For testing, use: https://webhook.site/your-unique-url
WEBHOOK_URL=

# ============================================
# Agent Configuration (Optional)
# ============================================
# Name displayed for the AI assistant
PARTICIPANT_NAME=AI Assistant

# Default room name for LiveKit sessions
ROOM_NAME=voice-agent-room

# ============================================
# Google Cloud Configuration (Optional)
# ============================================
# Path to Google Cloud service account credentials JSON
# Required for Google STT/TTS plugins
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# ============================================
# Notes:
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to version control
# 4. For testing webhook, visit https://webhook.site